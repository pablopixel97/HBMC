---
import '@fontsource-variable/jost';
import '../styles/tokens.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import Intro from '../components/Intro.astro';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';

interface Props {
  /** Título de la página; se completa con el nombre de la marca. */
  titulo?: string;
  descripcion?: string;
  /** Cierra la página con el formulario de cotización. */
  formulario?: boolean;
}

const { titulo, descripcion = site.descripcion, formulario = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.nombre}` : `${site.nombre} · ${site.lema}`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {/*
      Corre antes de pintar. Al llegar al sitio (no en una navegación interna) se marca la entrada del
      nav; en Archimagi el nav persiste entre páginas, así que su entrada no se repite. La intro sale
      solo en la primera llegada de la sesión: quien vuelve desde Google no espera otros 2 s.
    */}
    <script is:inline>
      if (!document.referrer.startsWith(location.origin)) {
        document.documentElement.dataset.llegada = '';
        let vista = false;
        try {
          vista = sessionStorage.getItem('hbmc-intro') === 'vista';
          sessionStorage.setItem('hbmc-intro', 'vista');
        } catch {}
        if (!vista && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.dataset.intro = '';
      }
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <Intro />
    <a class="saltar etiqueta" href="#contenido">Saltar al contenido</a>
    <Nav />
    <main id="contenido">
      <slot />
      {formulario && <FormularioContacto />}
    </main>
    <Footer />
  </body>
</html>

<style>
  .saltar {
    position: fixed;
    inset-block-start: var(--nav-margen);
    inset-inline-start: 50%;
    z-index: 200;
    translate: -50% -200%;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radio);
    background: var(--color-crema);
    color: var(--color-grafito);
  }

  .saltar:focus-visible {
    translate: -50% 0;
  }
</style>
