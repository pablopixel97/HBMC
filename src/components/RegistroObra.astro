---
// "/Registro de Obra" (sección "All Work" de Archimagi): el título queda fijo al centro de la pantalla
// y las fotos de proceso pasan por debajo, alejándose del mouse.
import { fotosRegistro } from '../data/registro';
import Imagen from './Imagen.astro';
import SectionTitle from './SectionTitle.astro';

type Tamano = 'grande' | 'media' | 'chica';

interface Celda {
  tamano: Tamano;
  alinear: 'start' | 'center' | 'end';
}

// Disposición de la referencia: filas de 5 fotos en una grilla de 13 columnas, con una columna vacía
// entre foto y foto. Si hay más de 15 fotos, las filas se repiten.
const filas: readonly (readonly Celda[])[] = [
  [
    { tamano: 'grande', alinear: 'center' },
    { tamano: 'chica', alinear: 'end' },
    { tamano: 'media', alinear: 'center' },
    { tamano: 'media', alinear: 'start' },
    { tamano: 'chica', alinear: 'center' },
  ],
  [
    { tamano: 'chica', alinear: 'end' },
    { tamano: 'media', alinear: 'center' },
    { tamano: 'media', alinear: 'end' },
    { tamano: 'chica', alinear: 'center' },
    { tamano: 'grande', alinear: 'center' },
  ],
  [
    { tamano: 'media', alinear: 'start' },
    { tamano: 'chica', alinear: 'center' },
    { tamano: 'grande', alinear: 'center' },
    { tamano: 'media', alinear: 'start' },
    { tamano: 'chica', alinear: 'center' },
  ],
];
const FOTOS_POR_FILA = 5;
// Columnas de la grilla en escritorio y en móvil; coinciden con grid-template-columns del CSS.
const COLUMNAS = 13;
const COLUMNAS_MOVIL = 6;
const columnasPorTamano: Record<Tamano, number> = { grande: 3, media: 2, chica: 1 };

const celdas = fotosRegistro.map((foto, i) => {
  const fila = Math.floor(i / FOTOS_POR_FILA);
  const posicion = i % FOTOS_POR_FILA;
  const patron = filas[fila % filas.length];
  const { tamano, alinear } = patron[posicion];
  const columnas = columnasPorTamano[tamano];
  // Columna de inicio: las fotos anteriores de la fila, cada una seguida de su columna vacía.
  const columna =
    1 + patron.slice(0, posicion).reduce((suma, c) => suma + columnasPorTamano[c.tamano] + 1, 0);
  return {
    foto,
    tamano,
    estilo: {
      '--fila': String(fila + 1),
      '--columna': String(columna),
      '--columnas': String(columnas),
      '--alinear': alinear,
    },
    // Las fotos más grandes miden 1200 px y aquí se ven a menos de un cuarto de pantalla.
    sizes: `(min-width: 810px) ${Math.ceil((100 * columnas) / COLUMNAS)}vw, ${Math.ceil((100 * columnas) / COLUMNAS_MOVIL)}vw`,
  };
});
---

<section class="registro tema-oscuro seccion" aria-labelledby="registro-titulo">
  <div class="cabecera contenedor">
    <SectionTitle id="registro-titulo" tenue="Registro" fuerte="de Obra" />
    <a class="boton etiqueta" href="/obras"><span class="boton-texto">Ver todas las obras</span></a>
  </div>

  <ul class="galeria" role="list" data-flotante>
    {
      celdas.map(({ foto, tamano, estilo, sizes }) => (
        <li class:list={['celda', tamano]} style={estilo}>
          <Imagen class="foto" foto={foto} sizes={sizes} />
        </li>
      ))
    }
  </ul>
</section>

<script>
  // Las fotos se alejan del mouse hasta 20 px ("Parallax Floating" de Archimagi). La suavidad la da
  // la transición de CSS; aquí solo se actualiza el desplazamiento, una vez por cuadro.
  const DISTANCIA_PX = 20;
  const puedeFlotar = window.matchMedia(
    '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
  );

  for (const galeria of document.querySelectorAll<HTMLElement>('[data-flotante]')) {
    let visible = false;
    let cuadro = 0;
    let mouseX = 0;
    let mouseY = 0;

    const mover = () => {
      cuadro = 0;
      const mitadX = window.innerWidth / 2;
      const mitadY = window.innerHeight / 2;
      galeria.style.setProperty('--flotar-x', `${((mitadX - mouseX) / mitadX) * DISTANCIA_PX}px`);
      galeria.style.setProperty('--flotar-y', `${((mitadY - mouseY) / mitadY) * DISTANCIA_PX}px`);
    };

    new IntersectionObserver(([entrada]) => {
      visible = entrada?.isIntersecting ?? false;
    }).observe(galeria);

    window.addEventListener(
      'mousemove',
      (evento) => {
        if (!visible || !puedeFlotar.matches) return;
        mouseX = evento.clientX;
        mouseY = evento.clientY;
        cuadro ||= requestAnimationFrame(mover);
      },
      { passive: true },
    );
  }
</script>

<style>
  .registro {
    /* Al flotar, las fotos de los bordes se salen hasta 20 px; sin esto aparecería scroll horizontal. */
    overflow: clip;
  }

  /* Queda fijo al centro de la pantalla, por encima de las fotos. */
  .cabecera {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2rem;
    height: 100svh;
    text-align: center;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radio);
    background: var(--color-acento);
    color: var(--color-grafito);
  }

  /* El anillo de foco global toma el color del texto, que aquí es grafito sobre la sección grafito. */
  .boton:focus-visible {
    outline-color: var(--color-acento);
  }

  /* Como los enlaces del nav: al pasar el mouse el texto solo crece. */
  .boton-texto {
    display: inline-block;
    transition: scale 0.5s var(--curva-resorte);
  }

  .boton:is(:hover, :focus-visible) .boton-texto {
    scale: 1.1;
  }

  .galeria {
    display: grid;
    grid-template-columns: repeat(13, minmax(0, 1fr));
    row-gap: var(--espacio-seccion);
    margin-block-start: var(--espacio-seccion);
    padding: 0;
    list-style: none;
    translate: var(--flotar-x, 0) var(--flotar-y, 0);
    transition: translate 0.85s var(--curva-amortiguada);
  }

  .celda {
    grid-row: var(--fila);
    grid-column: var(--columna) / span var(--columnas);
    align-self: var(--alinear);
  }

  .grande,
  .chica {
    --proporcion: 2 / 3;
  }

  .media {
    --proporcion: 0.92;
  }

  .foto {
    width: 100%;
    height: auto;
    aspect-ratio: var(--proporcion);
    object-fit: cover;
  }

  /* En móvil la grilla de 13 columnas no cabe: 6 columnas y las fotos se acomodan solas. */
  @media (max-width: 809px) {
    .galeria {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-flow: dense;
      gap: 3rem var(--margen);
    }

    .celda {
      grid-row: auto;
      grid-column: auto / span var(--columnas);
    }
  }
</style>
