---
// Hero de páginas interiores: foto a sangre con degradado y h1 abajo a la izquierda.
import type { Foto } from '../data/obras';
import Imagen from './Imagen.astro';

interface Props {
  titulo: string;
  foto?: Foto;
  /** `object-position` de la foto, para que el recorte no corte lo importante (p. ej. "center 25%"). */
  encuadre?: string;
  /** Texto chico en la esquina inferior derecha, p. ej. "Foto de referencia". */
  nota?: string;
}

const { titulo, foto, encuadre, nota } = Astro.props;
---

<section class="page-hero tema-oscuro" style={encuadre && `--encuadre: ${encuadre}`}>
  {foto && <Imagen class="fondo" foto={foto} layout="full-width" priority />}
  <h1 class="contenedor">{titulo}</h1>
  {nota && <p class="nota contenedor etiqueta">{nota}</p>}
</section>

<style>
  /* La nota comparte línea con el h1; si no cabe (móvil), pasa abajo y sigue a la derecha.
     Como en la referencia, el hero queda fijo y el contenido de la página sube por encima. */
  .page-hero {
    position: sticky;
    inset-block-start: 0;
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-end;
    align-items: flex-end;
    row-gap: 1rem;
    min-height: 100svh;
    padding-block-end: var(--margen);
    overflow: hidden;
  }

  /* Lo que viene después del hero lo tapa al hacer scroll: necesita fondo propio y quedar encima. */
  :global(.page-hero ~ *) {
    position: relative;
    z-index: 1;
    background-color: var(--color-fondo);
  }

  .fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--encuadre, center);
  }

  /* Degradado para que el título se lea sobre cualquier foto. */
  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-grafito) 85%, transparent),
      color-mix(in srgb, var(--color-grafito) 10%, transparent) 60%
    );
  }

  h1 {
    max-width: 18ch;
    font-size: var(--fs-titulo-seccion);
    letter-spacing: var(--ls-titulo);
    line-height: 1;
  }

  .nota {
    margin-inline-start: auto;
  }

  @media (max-width: 809px) {
    .page-hero {
      min-height: 95svh;
    }
  }
</style>
